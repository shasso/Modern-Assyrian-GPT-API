{
  "version": 1,
  "default": "Assur-SPM8K-Scribes-4M",
  "models": {
    "Assur-SPM8K-Scribes-4M": {
      "description": "Assur-SPM8K-Scribes-4M: GPT model trained on Old Testament text",
      "tokenizer": "models/ot_8000.model",
      "weights": "models/GPTot40.pth",
      "config": {
        "n_layer": 3,
        "n_head": 4,
        "n_embd": 256,
        "block_size": 128
      },
      "tags": ["baseline", "fast"]
    },
    "Assur-SPM32K-Biblica-10M": {
      "description": "Assur-SPM32K-Biblica-10M: GPT model trained on Bible text",
      "tokenizer": "models/bible_32000.model",
      "weights": "models/GPTbible40.pth",
      "config": {
        "n_layer": 3,
        "n_head": 4,
        "n_embd": 256,
        "block_size": 128
      },
      "tags": ["smaller", "faster"]
    },

    "assyrian-placeholder-large": {
      "description": "Placeholder for a larger model (add weights file, e.g. GPTot80.pth)",
      "tokenizer": "models/assyrian_8000.model",
      "weights": "models/GPTot80.pth",
      "config": {
        "n_layer": 6,
        "n_head": 8,
        "n_embd": 512,
        "block_size": 128
      },
      "tags": ["larger", "higher-quality"],
      "disabled": true
    }
  }
}
